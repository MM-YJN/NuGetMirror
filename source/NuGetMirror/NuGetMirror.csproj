<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <ContainerFamily>resolute-chiseled</ContainerFamily>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NuGetMirror.ServiceDefaults\NuGetMirror.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NuGetMirror.UnitTests" />
    <InternalsVisibleTo Include="NuGetMirror.IntegrationTests" />
    <InternalsVisibleTo Include="NuGetMirror.Contract.Tests" />
    <InternalsVisibleTo Include="NuGetMirror.E2E.Tests" />
  </ItemGroup>
</Project>
